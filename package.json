{
  "name": "vezgo-sdk-js",
  "version": "2.0.5",
  "description": "Official Vezgo JS SDK for the Browser & NodeJS",
  "author": "Wealthica Financial Technology Inc. <hello@wealthica.com> (https://wealthica.com/)",
  "license": "MIT",
  "main": "dist/vezgo.cjs.js",
  "module": "dist/vezgo.es.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "keywords": [
    "vezgo",
    "zabo",
    "cryptocurrency",
    "wallets",
    "bitcoin",
    "ethereum",
    "metamask",
    "ledger",
    "coinbase",
    "binance",
    "kraken",
    "api"
  ],
  "scripts": {
    "build": "rm -rf dist && yarn build:node && yarn build:browser && yarn build:types",
    "build:browser": "vite build --config vite.config.browser.mjs",
    "build:node": "vite build --config vite.config.node.mjs",
    "build:types": "cp src/index.d.ts dist/index.d.ts",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "watch:test": "vitest --watch",
    "lint": "eslint .",
    "lint-fix": "eslint --fix ."
  },
  "dependencies": {
    "apisauce": "^3.2.2",
    "jsonwebtoken": "^9.0.3"
  },
  "resolutions": {
    "pbkdf2": "^3.1.6",
    "sha.js": "^2.4.12",
    "cipher-base": "^1.0.7",
    "elliptic": "^6.6.1",
    "bn.js": "^4.12.3",
    "picomatch": "^4.0.5",
    "flatted": "^3.4.4",
    "qs": "^6.15.3"
  },
  "devDependencies": {
    "axios-mock-adapter": "^2.1.0",
    "eslint": "^10.8.1",
    "vite": "^8.2.2",
    "vite-plugin-node-polyfills": "^0.28.0",
    "vitest": "^4.1.11",
    "prettier": "^3.9.6"
  }
}
